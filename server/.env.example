# Committed template — copy this file to .env and fill real values. NEVER commit .env.
# ── Local development ──────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
JWT_SECRET="<generate-a-long-random-string-at-least-32-chars>"
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# ── Production (Render) — set these as env vars in the Render dashboard ──
# Render Blueprint auto-sets: NODE_ENV=production, PORT=4000, DATABASE_URL (from the linked DB).
# You MUST set these two manually after the service is created:
#   CLIENT_ORIGIN  → your Vercel frontend URL (e.g. "https://tgms.vercel.app")
#   JWT_SECRET     → Blueprint auto-generates this, or set your own long random string
# Optional: COOKIE_DOMAIN → set to "tgms-api.onrender.com" ONLY if you want the cookie
#   scoped exactly to the API subdomain (not required for same-site to work).