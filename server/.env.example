# ─── Required ───────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tgms?schema=public"
JWT_SECRET="generate-with-openssl-rand-hex-32"

# ─── Server ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ───────────────────────────────────────────────────
# In production set this to your Vercel frontend URL (e.g. https://tgms.vercel.app)
CLIENT_ORIGIN="http://localhost:5173"

# ─── Cookie ─────────────────────────────────────────────────
# Leave empty for local dev. In production, set if you need
# the cookie scoped to a specific domain.
COOKIE_DOMAIN=